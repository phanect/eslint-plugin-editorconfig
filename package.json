{
  "name": "eslint-plugin-editorconfig",
  "version": "5.0.0-beta1",
  "description": "An ESLint plugin to enforce EditorConfig rules",
  "author": "Jumpei Ogawa",
  "license": "Apache-2.0",
  "homepage": "https://github.com/phanect/eslint-plugin-editorconfig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phanect/eslint-plugin-editorconfig.git"
  },
  "bugs": {
    "url": "https://github.com/phanect/eslint-plugin-editorconfig/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "editorconfig"
  ],
  "type": "module",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/main.mjs",
        "types": "./dist/main.d.ts"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "./test-packages/test.sh && jiti tests/*.test.ts",
    "lint": "tsc --noEmit && eslint",
    "fix": "eslint --fix",
    "release": "pnpm publish . --access public",
    "clean": "git clean -dX --force",
    "refresh": "pnpm clean && rm --force ./pnpm-lock.yaml && corepack up && pnpm install"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^2.1.0",
    "@stylistic/eslint-plugin-js": "^2.1.0",
    "@stylistic/eslint-plugin-ts": "^2.1.0",
    "change-case": "^5.4.0",
    "deepmerge": "^4.3.1",
    "editorconfig": "^2.0.0",
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@phanect/configs": "latest",
    "@phanect/lint": "latest",
    "@phanect/utils": "^1.2.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "jiti": "latest",
    "mocha": "^10.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": "20.x || 22.x || >=24.x"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
