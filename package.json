{
  "name": "eslint-plugin-editorconfig",
  "version": "4.0.3",
  "description": "An ESLint plugin to enforce EditorConfig rules",
  "author": "Jumpei Ogawa",
  "license": "Apache-2.0",
  "homepage": "https://github.com/phanect/eslint-plugin-editorconfig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phanect/eslint-plugin-editorconfig.git"
  },
  "bugs": {
    "url": "https://github.com/phanect/eslint-plugin-editorconfig/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "editorconfig"
  ],
  "main": "main.js",
  "scripts": {
    "test": "./test-packages/test.sh && mocha --reporter dot tests/lib/**/*.js",
    "lint": "eslint",
    "fix": "eslint --fix",
    "release": "pnpm publish . --access public",
    "clean": "git clean -dX --force",
    "refresh": "pnpm clean && rm --force ./pnpm-lock.yaml && corepack up && pnpm install"
  },
  "dependencies": {
    "editorconfig": "^1.0.2",
    "eslint": "^8.40.0",
    "klona": "^2.0.4"
  },
  "devDependencies": {
    "@phanect/lint": "latest",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "jiti": "latest",
    "mocha": "^10.2.0"
  },
  "engines": {
    "node": "20.x || >=22.x"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
