{
  "name": "eslint-plugin-editorconfig",
  "version": "4.0.3",
  "description": "An ESLint plugin to enforce EditorConfig rules",
  "author": "Jumpei Ogawa",
  "license": "Apache-2.0",
  "homepage": "https://github.com/phanect/eslint-plugin-editorconfig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phanect/eslint-plugin-editorconfig.git"
  },
  "bugs": {
    "url": "https://github.com/phanect/eslint-plugin-editorconfig/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "editorconfig"
  ],
  "type": "module",
  "types": "./dist/main.d.ts",
  "module": "./dist/main.js",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "./test-packages/test.sh && mocha --reporter dot tests/lib/**/*.js",
    "lint": "tsc --noEmit && eslint .",
    "fix": "eslint --fix .",
    "release": "pnpm publish . --access public",
    "clean": "git clean -dX --force",
    "refresh": "pnpm clean && rm --force ./pnpm-lock.yaml && corepack up && pnpm install"
  },
  "dependencies": {
    "@phanect/utils": "^1.2.0",
    "@stylistic/eslint-plugin": "^5.1.0",
    "deepmerge": "^4.3.1",
    "editorconfig": "^3.0.1",
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@phanect/configs": "latest",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-config-phanective": "latest",
    "mocha": "^10.2.0",
    "tsup": "^8.5.0",
    "type-fest": "^4.41.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": "20.x || 22.x || >=24.x"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
