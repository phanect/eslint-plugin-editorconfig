{
  "extends": [
    "@phanect/configs/ts",
    "@phanect/configs/ts/addons/npm"
  ],
  "compilerOptions": {
    // Keep the compiled JavaScript code readable
    "preserveConstEnums": true,
    "removeComments": false,
    "typeRoots": [
      "./node_modules/@types",
      "./src/typedefs",
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs",
    "**/*.jsx"
  ],
  "exclude": [
    "**/node_modules/",
    "**/dist/",
    "./src/rules/charset.ts" // ignore until this rule is released again
  ]
}
