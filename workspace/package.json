{
  "name": "eslint-plugin-editorconfig",
  "version": "5.0.0-beta1",
  "description": "An ESLint plugin to enforce EditorConfig rules",
  "author": "Jumpei Ogawa",
  "license": "Apache-2.0",
  "homepage": "https://github.com/phanect/eslint-plugin-editorconfig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phanect/eslint-plugin-editorconfig.git"
  },
  "bugs": {
    "url": "https://github.com/phanect/eslint-plugin-editorconfig/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "editorconfig"
  ],
  "type": "module",
  "types": "./dist/main.d.ts",
  "module": "./dist/main.js",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "release": "pnpm publish . --access public",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@phanect/utils": "^1.2.0",
    "@stylistic/eslint-plugin": "^5.1.0",
    "deepmerge": "^4.3.1",
    "editorconfig": "^3.0.1",
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@phanect/configs": "latest",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "tsup": "^8.5.0",
    "type-fest": "^4.41.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "20.x || 22.x || >=24.x"
  }
}
